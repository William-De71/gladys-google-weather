{
  "name": "gladys-google-weather",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for the Google Maps Platform Weather API: current conditions, hourly and daily forecasts, official alerts, scene triggers and actions, dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-google-weather",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-google-weather.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "google-weather",
    "weather",
    "forecast",
    "weather-alerts",
    "home-automation"
  ]
}
